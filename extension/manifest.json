{
  "manifest_version": 3,
  "name": "有声下载·本地插件",
  "version": "0.7.1",
  "description": "把音频获取接口放到用户浏览器，走用户 IP 解析并下载到本地，节省服务器空间（同一卡密全局单下载槽：claim/心跳/完成释放）",
  "permissions": ["storage", "downloads", "downloads.ui", "alarms", "offscreen", "cookies", "notifications"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "有声下载·本地插件",
    "default_icon": { "128": "icon128.png" }
  },
  "icons": { "128": "icon128.png" }
}
